{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mimotrust.local/content-context-2.2.json",
  "title": "MiMoTrust Content Context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "trigger",
    "source_app",
    "provider",
    "content_ref",
    "content_access",
    "view_state",
    "observed_at"
  ],
  "properties": {
    "schema_version": { "const": "2.2" },
    "event_id": { "type": "string", "format": "uuid" },
    "trigger": { "enum": ["comment", "share", "guardian_request"] },
    "source_app": { "const": "mimotrust_controlled_content" },
    "provider": { "$ref": "#/$defs/provider" },
    "content_ref": { "$ref": "#/$defs/content_ref" },
    "content_access": { "$ref": "#/$defs/content_access" },
    "view_state": {
      "oneOf": [
        { "$ref": "#/$defs/media_view_state" },
        { "$ref": "#/$defs/reading_view_state" },
        { "$ref": "#/$defs/gallery_view_state" }
      ]
    },
    "observed_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "content_ref": {
            "properties": { "content_type": { "enum": ["video", "audio"] } },
            "required": ["content_type"]
          }
        }
      },
      "then": { "properties": { "view_state": { "$ref": "#/$defs/media_view_state" } } }
    },
    {
      "if": {
        "properties": {
          "content_ref": {
            "properties": { "content_type": { "enum": ["article", "rich_article"] } },
            "required": ["content_type"]
          }
        }
      },
      "then": { "properties": { "view_state": { "$ref": "#/$defs/reading_view_state" } } }
    },
    {
      "if": {
        "properties": {
          "content_ref": {
            "properties": { "content_type": { "const": "image_gallery" } },
            "required": ["content_type"]
          }
        }
      },
      "then": { "properties": { "view_state": { "$ref": "#/$defs/gallery_view_state" } } }
    },
    {
      "if": { "properties": { "trigger": { "const": "guardian_request" } } },
      "then": {
        "properties": {
          "content_access": {
            "properties": { "mode": { "const": "grant_exchange" } },
            "required": ["exchange_url", "grant_code", "audience", "expires_at", "scopes"]
          }
        }
      }
    },
    {
      "if": { "properties": { "trigger": { "enum": ["comment", "share"] } } },
      "then": {
        "properties": {
          "content_access": {
            "properties": { "mode": { "const": "deferred_grant" } },
            "maxProperties": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_id", "application_id"],
      "properties": {
        "provider_id": { "const": "mimotrust_sandbox" },
        "application_id": { "const": "com.mimotrust.controlledcontent" }
      }
    },
    "content_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_type",
        "content_id",
        "content_version",
        "content_hash",
        "canonical_url"
      ],
      "properties": {
        "content_type": {
          "enum": ["video", "audio", "article", "rich_article", "image_gallery"]
        },
        "content_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "content_version": { "type": "string", "pattern": "^v[1-9][0-9]*$" },
        "content_hash": { "$ref": "#/$defs/sha256" },
        "canonical_url": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },
    "content_access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["deferred_grant", "grant_exchange", "public_manifest", "content_uri"] },
        "exchange_url": { "type": "string", "format": "uri" },
        "grant_code": { "type": "string", "minLength": 1, "maxLength": 512 },
        "audience": { "const": "mimotrust_guardian_backend" },
        "expires_at": { "type": "string", "format": "date-time" },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["manifest:read", "asset:read"] }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "grant_exchange" } } },
          "then": {
            "required": ["exchange_url", "grant_code", "audience", "expires_at", "scopes"]
          }
        }
      ]
    },
    "media_view_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position_ms", "duration_ms", "is_playing"],
      "properties": {
        "position_ms": { "type": "integer", "minimum": 0 },
        "duration_ms": { "type": "integer", "minimum": 1 },
        "is_playing": { "type": "boolean" }
      }
    },
    "reading_view_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scroll_ratio", "block_index"],
      "properties": {
        "scroll_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "block_index": { "type": "integer", "minimum": 0 }
      }
    },
    "gallery_view_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active_asset_index", "asset_count"],
      "properties": {
        "active_asset_index": { "type": "integer", "minimum": 0 },
        "asset_count": { "type": "integer", "minimum": 1 }
      }
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
