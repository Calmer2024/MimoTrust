{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mimotrust.local/content-manifest-1.0.json",
  "title": "MiMoTrust Sandbox Content Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "provider",
    "content",
    "assets",
    "rights",
    "sandbox"
  ],
  "properties": {
    "manifest_version": {
      "const": "1.0"
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_id"],
      "properties": {
        "provider_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_type",
        "content_id",
        "content_version",
        "content_hash",
        "canonical_url",
        "title",
        "author",
        "published_at"
      ],
      "properties": {
        "content_type": {
          "enum": [
            "video",
            "audio",
            "article",
            "rich_article",
            "image_gallery"
          ]
        },
        "content_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "content_version": {
          "type": "string",
          "pattern": "^v[1-9][0-9]*$"
        },
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "canonical_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "published_at": {
          "type": "string",
          "format": "date-time"
        },
        "body_asset_id": {
          "type": "string",
          "minLength": 1
        },
        "asset_order": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["block_index", "block_type"],
            "properties": {
              "block_index": {
                "type": "integer",
                "minimum": 0
              },
              "block_type": {
                "enum": ["text", "image"]
              },
              "text": {
                "type": "string"
              },
              "asset_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id",
          "role",
          "mime_type",
          "source_url",
          "sha256",
          "size_bytes",
          "derivation"
        ],
        "properties": {
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": ["original", "playback", "analysis", "cover", "subtitle"]
          },
          "mime_type": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^(https://|http://127\\.0\\.0\\.1(?::[0-9]+)?/)"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 1
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "frame_rate": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "video_codec": {
            "type": "string",
            "minLength": 1
          },
          "audio_codec": {
            "type": "string",
            "minLength": 1
          },
          "derivation": {
            "enum": [
              "original",
              "same_as_original",
              "same_as_playback",
              "normalized_from_original"
            ]
          },
          "source_asset_id": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "integer",
            "minimum": 0
          },
          "original_name": {
            "type": "string",
            "minLength": 1
          },
          "storage": {
            "type": "object",
            "additionalProperties": false,
            "required": ["provider", "object_key"],
            "properties": {
              "provider": {
                "enum": ["aliyun_oss", "local"]
              },
              "object_key": {
                "type": "string",
                "minLength": 1
              },
              "bucket": {
                "type": "string",
                "minLength": 1
              },
              "endpoint": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "http": {
            "type": "object",
            "additionalProperties": false,
            "required": ["accept_ranges", "etag", "last_modified"],
            "properties": {
              "accept_ranges": {
                "type": "boolean"
              },
              "etag": {
                "type": "string"
              },
              "last_modified": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "retention_seconds", "redistribution_allowed"],
      "properties": {
        "purpose": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "retention_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "redistribution_allowed": {
          "type": "boolean"
        }
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["access_enforcement", "development_asset"],
      "properties": {
        "access_enforcement": {
          "enum": ["local_filesystem", "mock_gateway_only", "signed_url"]
        },
        "development_asset": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
