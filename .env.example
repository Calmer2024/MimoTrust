# Obtain a key from https://platform.xiaomimimo.com/
MIMO_API_KEY=
EXA_API_KEY=

# M1-M7 下游信源核实
MIMO_PLANNING_MODEL=mimo-v2.5
MIMO_PLANNING_TIMEOUT_SECONDS=45
MIMO_PLANNING_QUALITY_TIMEOUT_SECONDS=120
MIMO_PLANNING_MAX_COMPLETION_TOKENS=1200
# speed 关闭思考；quality 开启思考并预留推理 token。
MIMO_PLANNING_SPEED_MAX_COMPLETION_TOKENS=4800
MIMO_PLANNING_QUALITY_MAX_COMPLETION_TOKENS=19200
MIMO_PLANNING_TEMPERATURE=0.1
MIMOTRUST_MIN_QUERY_COUNT=5
MIMOTRUST_MAX_QUERY_COUNT=12

EXA_SEARCH_URL=https://api.exa.ai/search
EXA_SEARCH_TYPE=auto
EXA_NUM_RESULTS=10
EXA_TIMEOUT_SECONDS=10
# 小幅错峰仍保持并发，降低同一瞬间多请求的长尾超时概率；设为 0 可关闭。
EXA_REQUEST_STAGGER_MS=200
# APP/Web 档位的单查询预算；查询数量不因档位减少。
EXA_SPEED_TIMEOUT_SECONDS=10
EXA_QUALITY_TIMEOUT_SECONDS=10
EXA_USER_LOCATION=CN
EXA_INCLUDE_HIGHLIGHTS=true

MIMO_TRIAGE_MODEL=mimo-v2.5-pro
MIMO_TRIAGE_TIMEOUT_SECONDS=45
MIMO_TRIAGE_QUALITY_TIMEOUT_SECONDS=120
MIMO_TRIAGE_MAX_COMPLETION_TOKENS=750
# speed 关闭思考；quality 开启思考并预留推理 token。
MIMO_TRIAGE_SPEED_MAX_COMPLETION_TOKENS=750
MIMO_TRIAGE_QUALITY_MAX_COMPLETION_TOKENS=12000
MIMO_TRIAGE_TEMPERATURE=0
MIMO_TRIAGE_TARGET_BATCH_CHARACTERS=24000
MIMO_TRIAGE_MAX_BATCHES=4
# 原始视频/图文上下文会贯穿 M2/M5/M6，仅用于语义锚定，不是事实证据。
MIMOTRUST_SOURCE_CONTEXT_MAX_CHARS=12000

MIMO_REPORT_MODEL=mimo-v2.5-pro
# Web/APP 档位统一控制 M2/M5/M6 思考：speed=disabled，quality=enabled。
MIMO_REPORT_TIMEOUT_SECONDS=180
MIMO_REPORT_MAX_COMPLETION_TOKENS=24000
MIMO_REPORT_MAX_ATTEMPTS=2
MIMO_REPORT_TEMPERATURE=0.1

MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_SUMMARY_MODEL=mimo-v2.5
MIMO_ASR_MODEL=mimo-v2.5-asr

# Demo safety limits
MAX_VIDEO_DURATION_SECONDS=1800
MAX_TRANSCRIPT_CHARS=50000
CACHE_TTL_SECONDS=86400

# Optional Netscape-format cookie file. Douyin commonly requires fresh cookies.
# Use a dedicated, low-privilege service session. Never commit this file.
YTDLP_COOKIES_FILE=
# Must match the browser UA used when the Cookie file was exported.
YTDLP_USER_AGENT=
KUAISHOU_COOKIES_FILE=
KUAISHOU_USER_AGENT=
WECHAT_CHANNELS_COOKIES_FILE=
WECHAT_CHANNELS_USER_AGENT=

# Development only: launch an isolated local Edge session to refresh anonymous
# Douyin cookies. Production should use an authorized platform adapter.
DOUYIN_AUTO_COOKIES=true
DOUYIN_COOKIE_MAX_AGE_SECONDS=1800
# Persistent, dedicated browser profile; never point this at a personal profile.
DOUYIN_BROWSER_PROFILE_DIR=.cache/douyin-browser-profile
DOUYIN_BROWSER_HEADLESS=true

# Extraction controls
ASR_CHUNK_SECONDS=75
ASR_CONCURRENCY=3
VIDEO_VISUAL_FPS=0.2
KEYFRAME_SCENE_THRESHOLD=0.28
KEYFRAME_PERIOD_SECONDS=30
KEYFRAME_MAX_FRAMES=16
FULL_VISUAL_ESCALATION=true
MIMO_JOB_MODE=memory
DATABASE_URL=postgresql+asyncpg://mimotrust:mimotrust@localhost:5432/mimotrust
REDIS_URL=redis://localhost:6379/0
JOB_QUEUE_NAME=mimotrust:jobs
# Mobile multipart attachments are staged here until their job reads them.
JOB_UPLOAD_DIR=.cache/job-uploads
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=mimotrust
S3_SECRET_KEY=mimotrust-secret
S3_BUCKET=mimotrust-artifacts
S3_REGION=us-east-1
# 归档失败不得阻塞 APP 收到核验完成事件。
S3_UPLOAD_TIMEOUT_SECONDS=5
